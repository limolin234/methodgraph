# Default registration for a trusted ingestion agent. Keep authority=agent;
# start a separate human-authority process only for deliberate curation.
[mcp_servers.methodgraph_admin]
command = "/path/to/methodgraph-env/bin/methodgraph-admin-mcp"
args = []
env = {
  METHODGRAPH_DB = "/path/to/methodgraph.db",
  METHODGRAPH_ACTOR = "ingestion-agent",
  METHODGRAPH_ACTOR_AUTHORITY = "agent",
  METHODGRAPH_EMBEDDING_MODEL = "none",
}
required = false
startup_timeout_sec = 20
tool_timeout_sec = 60
