[Unit]
Description=MethodGraph local retrieval service
After=network.target

[Service]
Type=simple
Environment=METHODGRAPH_CONFIG=/path/to/config.toml
Environment=HF_HUB_OFFLINE=1
Environment=HF_DATASETS_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
ExecStart=/path/to/methodgraph-env/bin/methodgraph-server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
