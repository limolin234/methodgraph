[Unit]
Description=MethodGraph local retrieval service
After=network.target

[Service]
Type=simple
Environment=METHODGRAPH_DB=/path/to/methodgraph.db
Environment=METHODGRAPH_TRANSPORT=streamable-http
Environment=METHODGRAPH_HOST=127.0.0.1
Environment=METHODGRAPH_PORT=8765
Environment=METHODGRAPH_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
Environment=METHODGRAPH_EMBEDDING_DEVICE=cuda
ExecStart=/path/to/methodgraph-env/bin/methodgraph-mcp
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
